# =========================================================
# Project Zomboid mod repo .gitattributes
# This file does NOT exclude anything. All assets are still
# committed. It only tells git how to handle each file type.
# =========================================================

# ---- Text: normalize line endings to LF ----
* text=auto eol=lf

*.lua      text eol=lf
*.txt      text eol=lf
*.xml      text eol=lf
*.json     text eol=lf
*.info     text eol=lf
*.md       text eol=lf
*.ini      text eol=lf
*.cfg      text eol=lf
*.csv      text eol=lf
*.fnt      text eol=lf

# ---- Binary game assets: no diffs, no line-ending changes ----
# Images
*.png      binary
*.PNG      binary
*.jpg      binary
*.JPG      binary
*.jpeg     binary
*.JPEG     binary
*.gif      binary
*.GIF      binary
*.tga      binary
*.TGA      binary
*.dds      binary
*.DDS      binary

# Models and animations
*.fbx      binary
*.FBX      binary
*.x        binary
*.X        binary

# Sound
*.ogg      binary
*.OGG      binary
*.wav      binary
*.WAV      binary
*.mp3      binary
*.MP3      binary
*.bank     binary

# Packed textures and fonts
*.pack     binary
*.ttf      binary
*.TTF      binary
*.otf      binary
*.OTF      binary

# ---- Art source files ----
# Committed as binary. If a repo gets heavy, run `git lfs install`
# and uncomment the matching LFS lines below.
*.blend    binary
*.psd      binary
*.PSD      binary
*.kra      binary
*.aseprite binary
*.xcf      binary
